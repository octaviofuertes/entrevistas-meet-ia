# ============================================================
# Sistema de Entrevistas Automatizadas con IA (v2.0)
# Variables de Entorno
# ============================================================
# Copiar a .env y completar los valores.
# Por defecto todo está en modo MOCK: arranca sin pagar nada,
# sin Recall.ai, sin ElevenLabs y sin Anthropic.

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

JWT_SECRET=cambia-este-secret-en-produccion-por-favor-32-chars-min
JWT_EXPIRES_IN=24h
ADMIN_TOKEN=admin-demo-token-cambiar

CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------
# Base de Datos
# ------------------------------------------------------------
# memory   = en memoria (default, modo demo)
# postgres = PostgreSQL real (docker-compose o cloud)
DATABASE_DRIVER=memory
DATABASE_URL=postgresql://entrevistas:entrevistas@localhost:5433/entrevistas

# ------------------------------------------------------------
# leIA - IA propia del sistema
# ------------------------------------------------------------
# mock   = heurística determinista (default)
# claude = Anthropic Claude (modelo interno)
# gemini = Google Generative Language (uso temporal mientras leIA tiene IA propia)
LEIA_DRIVER=mock
LEIA_MODEL=claude-opus-4-7
ANTHROPIC_API_KEY=

# Para LEIA_DRIVER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Idioma de la entrevista (afecta voz y prompts).
INTERVIEW_LANGUAGE=es

# ------------------------------------------------------------
# Recall.ai - bot que ingresa a Google Meet y captura captions
# ------------------------------------------------------------
# mock   = simula el bot, los captions y la reproducción de audio
# recall = Recall.ai real (requiere RECALL_API_KEY)
RECALL_DRIVER=mock
RECALL_API_KEY=
RECALL_REGION=us-east-1
RECALL_BOT_NAME=leIA · Entrevistadora

# ------------------------------------------------------------
# ElevenLabs - síntesis de voz (TTS)
# ------------------------------------------------------------
# mock       = devuelve un buffer placeholder
# elevenlabs = API real
TTS_DRIVER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# ------------------------------------------------------------
# Job-from-link
# ------------------------------------------------------------
JOB_LINK_TIMEOUT_MS=15000

# ------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_ADMIN_TOKEN=admin-demo-token-cambiar
